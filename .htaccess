# DŌJŌ JAPAN — Xserver / Apache config

# ---- MIME ----------------------------------------------------------------
AddType video/mp4 .mp4 .m4v
AddType video/webm .webm
AddType image/svg+xml .svg
AddType application/font-woff2 .woff2
AddType image/webp .webp

# ---- HTTPS redirect (uncomment after SSL is verified) --------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---- Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser cache -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML & CSS & JS — never cache (always revalidate via ETag/Last-Modified)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  # Images
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  # Video (long — never changes once uploaded)
  ExpiresByType video/mp4 "access plus 60 days"
  ExpiresByType video/webm "access plus 60 days"
  # Fonts
  ExpiresByType application/font-woff2 "access plus 60 days"
</IfModule>

# ---- Cache-Control headers ----------------------------------------------
<IfModule mod_headers.c>
  # Strip any inherited cache headers first to avoid conflicts
  Header unset Pragma
  Header unset Expires
  Header unset Cache-Control

  # Video / images / fonts — long cache, byte-range for video seek
  <FilesMatch "\.(mp4|m4v|webm)$">
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=5184000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # CSS / JS — never serve stale; revalidate every request (304 if unchanged)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
  # HTML — never cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Reasonable security
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- ETag for proper 304 responses ---------------------------------------
FileETag MTime Size

# ---- Default index -------------------------------------------------------
DirectoryIndex index.html
Options -Indexes

# ---- Pretty error fallbacks (optional) -----------------------------------
ErrorDocument 404 /index.html
